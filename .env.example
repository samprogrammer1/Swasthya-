# Environment Variables for Swasthya+

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
WEB_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=swasthya_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication
JWT_SECRET=swasthya_super_secret_jwt_key_2026_jodhpur
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=swasthya_refresh_token_secret_key_2026
REFRESH_TOKEN_EXPIRES_IN=7d

# Feature Flags
ENABLE_ABDM_INTEGRATION=false
ENABLE_RAZORPAY_SANDBOX=false
